# ─────────────────────────────────────────
# ProposeAI — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub
# ─────────────────────────────────────────

# Supabase — get from: supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY

# Anthropic — get from: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Stripe — get from: dashboard.stripe.com > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — get from: Stripe Dashboard > Products
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# App URL — your Vercel URL or custom domain
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
